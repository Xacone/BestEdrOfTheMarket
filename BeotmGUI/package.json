{
  "name": "beotmgui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "prettier --check . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
