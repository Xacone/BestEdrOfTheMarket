    "@sveltejs/kit": "^2.53.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.2.0",
    "daisyui": "^5.5.19",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.53.2",
    "svelte-check": "^4.4.3",
    "svelte-i18n": "4.0.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "es5-ext",
      "esbuild"
